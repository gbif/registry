<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <!-- Tables owned and written by flow-orchestrator (workflow state, commands, outbox, reports). -->
  <changeSet id="189" author="nreibke">
    <sqlFile path="liquibase/189-orchestrator-tables.sql" splitStatements="true"/>
    <rollback>
      <sql>
        DROP TABLE workflow_report;
        DROP TABLE outbox_message;
        DROP TABLE workflow_command;
        DROP TABLE step_attempt;
        DROP TABLE step_execution;
        DROP TABLE workflow_execution;
      </sql>
    </rollback>
  </changeSet>
</databaseChangeLog>
